MVA_BIND_ADDRESS=127.0.0.1
MVA_PORT=8890
APP_ENV=production
COOKIE_SECURE=true
TRUSTED_HOSTS=mva.internal.example
CORS_ORIGINS=https://mva.internal.example
DATABASE_NAME=mva
DATABASE_USER=mva
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=15
SESSION_HOURS=8
AI_API_STYLE=ollama
AI_BASE_URL=http://ai-server.internal:11434
AI_MODEL=gemma3:12b
AI_TIMEOUT_SECONDS=600
AI_TLS_VERIFY=true
AI_AUTH_HEADER=Authorization
AI_AUTH_SCHEME=Bearer
